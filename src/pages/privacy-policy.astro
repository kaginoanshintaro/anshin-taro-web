---
// プライバシーポリシー（/privacy-policy/。URL は今の WordPress と同じ）。
// 文は src/data/privacy.ts（今のページから写したもの）。
// パソコン版: 料金ページと同じく、左に項目のメニュー（スクロールしても付いてくる）、右に白いカードの本文。
import Base from "../layouts/Base.astro";
import { privacySections } from "../data/privacy";
import "../styles/privacy.css";

// 文中の URL・電話番号・メールアドレスをリンクにする（スマホで押せるように）
const linkPattern = /(https?:\/\/[^\s　]+|0\d{1,3}-\d{2,4}-\d{4}|[\w.+-]+@[\w-]+\.[\w.-]+)/;
const linkify = (text: string) => text.split(linkPattern).filter(Boolean);
const hrefOf = (t: string) =>
	/^https?:/.test(t) ? t : t.includes("@") ? `mailto:${t}` : /^0\d/.test(t) && /^[\d-]+$/.test(t) ? `tel:${t.replace(/-/g, "")}` : null;
---

<Base title="プライバシーポリシー">
	<div class="privacy-page">
		<header class="pv-head">
			<div class="wrap">
				<h1>プライバシーポリシー</h1>
				<nav class="pv-crumb" aria-label="現在地"><a href="/">ホーム</a><span aria-hidden="true">›</span>プライバシーポリシー</nav>
			</div>
		</header>

		<div class="wrap pv-layout">
			<aside class="pv-side">
				<nav aria-label="項目">
					<details class="pv-toc" open>
						<summary class="pv-toc-title">目次</summary>
						<ol>
							{privacySections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
						</ol>
					</details>
				</nav>
			</aside>

			<article class="pv-card">
				{privacySections.map((s) => (
					<section id={s.id}>
						<h2>{s.title}</h2>
						{s.body.map((b) =>
							typeof b === "string" ? (
								<p>{linkify(b).map((t) => (/^https?:/.test(t) ? <a href={t} target="_blank" rel="noopener">{t}</a> : t))}</p>
							) : (
								<ul>{b.list.map((li) => <li>{linkify(li).map((t) => { const h = hrefOf(t); return h && !h.startsWith("http") ? <a href={h}>{t}</a> : t; })}</li>)}</ul>
							),
						)}
					</section>
				))}
			</article>
		</div>

		<div class="pv-cta">
			<a class="pv-cta-home" href="/">ホームに戻る</a>
		</div>
	</div>
</Base>

<script>
	// スマホでは目次を閉じた状態から始め、項目を押したら閉じる。パソコンは開いたまま
	const toc = document.querySelector<HTMLDetailsElement>(".pv-toc");
	const phone = window.matchMedia("(max-width: 767px)");
	if (toc) {
		toc.open = !phone.matches;
		phone.addEventListener("change", () => (toc.open = !phone.matches));
		toc.querySelector("summary")?.addEventListener("click", (e) => {
			if (!phone.matches) e.preventDefault();
		});
		toc.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => {
			if (phone.matches) toc.open = false;
		}));
	}
</script>
