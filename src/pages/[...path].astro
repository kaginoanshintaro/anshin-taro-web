---
// WordPress と同じ URL を出す受け口。
//   /<slug>/          固定ページ（親なし）→ なければ投稿
//   /<親>/<slug>/     親ページを持つ固定ページ（parent_slug で照合）
import { getEmDashCollection, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import SizedImage from "../components/SizedImage.astro";
import PTColumns from "../components/PTColumns.astro";
import TipArticle from "../components/TipArticle.astro";
import PostArticle from "../components/PostArticle.astro";
import { findTip, hintGroup } from "../data/tips";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

let segments: string[] = [];
try {
	segments = (Astro.params.path ?? "").split("/").filter(Boolean).map((s) => decodeURIComponent(s));
} catch {
	return Astro.rewrite("/404");
}
if (segments.length === 0 || segments.length > 2) return Astro.rewrite("/404");

const slug = segments[segments.length - 1];
const parent = segments.length === 2 ? segments[0] : "";

let collection: "pages" | "posts" = "pages";
let { entry, cacheHint } = await getEmDashEntry("pages", slug);
if (entry && (entry.data.parent_slug ?? "") !== parent) entry = null;
if (!entry && !parent) {
	collection = "posts";
	({ entry, cacheHint } = await getEmDashEntry("posts", slug));
}
if (!entry) return Astro.rewrite("/404");

// 固定ページ・投稿は Cloudflare の入口にキャッシュする（更新時は EmDash がタグで消す）
if (Astro.cache?.enabled) {
	Astro.cache.set({ maxAge: 3600, swr: 86400, tags: ["all"] });
	Astro.cache.set(cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(entry, { siteTitle, siteUrl: Astro.url.origin, path: Astro.url.pathname });
const categories = entry.data.terms?.category ?? [];
// お役立ち情報の一覧（src/data/tips.ts）に載っている固定ページは、記事用の形で出す
const tipPath = `/${segments.join("/")}/`;
const isTip = collection === "pages" && findTip(tipPath) !== null;
// ブログの「ヒント」カテゴリの投稿（お役立ち情報の「現場からのヒント」）も、同じ記事の形で出す。並びは一覧と同じ新しい順
let hintTip: { group: { id: string; title: string }; flat: { path: string; title: string }[]; index: number } | undefined;
if (collection === "posts" && categories.some((c) => c.slug === hintGroup.category)) {
	const { entries: hints, cacheHint: hintsHint } = await getEmDashCollection("posts", { where: { category: hintGroup.category }, orderBy: { published_at: "desc" }, limit: 100 });
	if (Astro.cache?.enabled) Astro.cache.set(hintsHint);
	const flat = hints.map((h) => ({ path: `/${h.id}/`, title: h.data.title }));
	const index = flat.findIndex((h) => h.path === tipPath);
	if (index >= 0) hintTip = { group: hintGroup, flat, index };
}
// アイキャッチ（投稿のみ。2026-11-16 佐藤さん: 記事の一番上と SNS 共有の画像にも出す）
const featured = collection === "posts" ? (entry.data.featured_image ?? null) : null;
const featuredSrc: string | null = featured && typeof featured === "object" && "src" in featured && featured.src ? String(featured.src).replace(/^http:\/\//, "https://") : null;
// カラム（左に画像・右に文など）の中の画像も出るよう、カラムの部品を置き換える
const ptComponents = { type: { image: SizedImage, columns: PTColumns } };
---

<Base title={seo.title} pageTitle={seo.ogTitle} description={seo.description} canonical={seo.canonical} image={featuredSrc} content={{ collection, id: entry.data.id, slug }}>
	{hintTip ? (
		<TipArticle path={tipPath} title={entry.data.title} edit={entry.edit.title} tip={hintTip} date={entry.data.publishedAt ?? null}>
			{featuredSrc && <figure class="post-eyecatch" {...entry.edit.featured_image}><img src={featuredSrc} alt="" decoding="async" fetchpriority="high" /></figure>}
			<PortableText value={entry.data.content} components={ptComponents} />
		</TipArticle>
	) : isTip ? (
		<TipArticle path={tipPath} title={entry.data.title} edit={entry.edit.title}>
			<PortableText value={entry.data.content} components={ptComponents} />
		</TipArticle>
	) : collection === "posts" ? (
		<PostArticle title={entry.data.title} edit={entry.edit.title} categories={categories} date={entry.data.publishedAt ?? null}>
			{featuredSrc && <figure class="post-eyecatch" {...entry.edit.featured_image}><img src={featuredSrc} alt="" decoding="async" fetchpriority="high" /></figure>}
			<PortableText value={entry.data.content} components={ptComponents} />
		</PostArticle>
	) : (
		<article data-collection={collection}>
			<h1 {...entry.edit.title}>{entry.data.title}</h1>
			{categories.map((c) => <a href={`/category/${c.slug}/`}>{c.label}</a>)}
			{featuredSrc && <figure class="post-eyecatch" {...entry.edit.featured_image}><img src={featuredSrc} alt="" decoding="async" fetchpriority="high" /></figure>}
			<PortableText value={entry.data.content} components={ptComponents} />
		</article>
	)}
</Base>

<style is:global>
	/* アイキャッチ: 本文の幅いっぱい、縦長でも高くなりすぎないように */
	.post-eyecatch { margin: 1rem 0 1.5rem; }
	.post-eyecatch img { display: block; width: 100%; height: auto; max-height: 70vh; object-fit: contain; border-radius: 8px; background: #f4f1ee; }
</style>
