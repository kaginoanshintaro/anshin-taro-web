---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import { site } from "../site";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 5,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// ファーストビューの大きな画像。今は今のサイトの背景イラスト（background_pic.jpg）で試している
const fvImage = "/images/top/fv-background_pic.jpg";

const dateFormat = new Intl.DateTimeFormat("ja-JP", {
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
	timeZone: "Asia/Tokyo",
});

// 文章は今の WordPress のトップ（固定ページ HOME）から写したもの
const services = [
	{
		title: "カギの開錠",
		href: "/lock-opening/",
		image: "/images/top/service-lock-opening.jpg",
		text: "デスクやロッカー、南京錠などの簡易錠から他店では断られる事も多い防犯性の高い鍵、電子錠やカードキーなども高い技術力で非破壊開錠いたします。金庫、自動車、スーツケースなどあらゆるカギに対応します。",
	},
	{
		title: "カギの修理・交換・取付",
		href: "/repair/",
		image: "/images/top/service-repair.jpg",
		text: "鍵の修理交換や錠前のお取り付けを承ります。ドアの建て付けの調整やドアクローザーの交換、スマートロックや電子錠の取付、インターホンや防犯カメラなどの防犯機器もご相談ください。",
	},
	{
		title: "カギの作成",
		href: "/duplicate/",
		image: "/images/top/service-duplicate.jpg",
		text: "合鍵の作成を承ります。出張作成も可能です。防犯性の高いディンプルキーやウェーブキーなどの特殊キーはもちろん、自動車やバイクのイモビライザーキーの鍵作成、鍵を無くしてしまった場合の鍵なし鍵作成はおまかせください。",
	},
];
---

<Base title={site.name} description={site.tagline}>
	<section class="fv" style={`--fv-image: url(${fvImage})`}>
		<div class="fv-inner">
			<img class="fv-logo" src="/images/top/logo.png" alt={site.name} width="600" height="240" />
			<p class="fv-lead">いつ、いかなる時も 佐藤 が参ります</p>
			<h1 class="fv-title">一人社長の鍵屋さんです</h1>
			<a class="btn btn-large" href={site.tel.href}>{site.tel.label}</a>
		</div>
		<a class="fv-scroll" href="#intro" aria-label="下へスクロール">scroll</a>
		<svg class="fv-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
			<path d="M0,48 C240,88 480,8 720,40 C960,72 1200,24 1440,52 L1440,80 L0,80 Z" />
		</svg>
	</section>

	<section class="section" id="intro">
		<div class="wrap intro">
			<img class="intro-photo is-round" src="/images/top/sato.png" alt="代表の佐藤" width="320" height="320" loading="lazy" />
			<div>
				<h2 class="intro-title">／私が佐藤です＼</h2>
				<p>弊社では従業員を置かず代表の私、佐藤が直接電話応対から作業までを一手に担います。</p>
				<p>依頼が集中する場合は少々お待ちいただくこともございますが、その分仲介手数料などの余計なコストが発生せず、お客様一人ひとりに向けた丁寧で柔軟なサービスを提供できることが弊社の強みです。</p>
				<p>お客様が “安心して依頼できる” 信頼のおける会社を目指し、日々努力を重ねております。お客様の立場に立ったサービスを心掛け、皆様にとって最良のパートナーであり続けることをお約束いたします。</p>
			</div>
		</div>
		<div class="wrap intro is-reverse">
			<img class="intro-photo" src="/images/top/anshin-taro-thumbsup.png" alt="安心太郎ちゃん" width="400" height="596" loading="lazy" />
			<div>
				<h2 class="intro-title">安心太郎ちゃん</h2>
				<p>マスコットキャラクターのAIエージェント、安心太郎ちゃん。暮らしの安心と安全を守るため、佐藤とともに活躍しています。よろしくね！</p>
				<p>ホームページをブックマークすると安心太郎ちゃんの顔がアイコンになるよ！ためしてみてね〜♪</p>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<h2 class="section-title">サービス紹介</h2>
			<ul class="cards">
				{
					services.map((s) => (
						<li class="card">
							<img class="card-image" src={s.image} alt="" loading="lazy" />
							<h3>{s.title}</h3>
							<p>{s.text}</p>
							<a class="btn" href={s.href}>さらに詳しく</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section cta">
		<div class="wrap">
			<p class="cta-lead">電話で見積もりOK！佐藤が電話に出ます</p>
			<a class="btn btn-large" href={site.tel.href}>{site.tel.label}</a>
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<h2 class="section-title">NEWS</h2>
			<ul class="news">
				{
					posts.map((post) => (
						<li>
							{post.data.publishedAt && (
								<time datetime={post.data.publishedAt.toISOString()}>
									{dateFormat.format(post.data.publishedAt)}
								</time>
							)}
							<a href={`/${post.id}/`}>{post.data.title}</a>
						</li>
					))
				}
			</ul>
			<p class="more"><a href="/news/">もっと見る</a></p>
		</div>
	</section>

	<section class="section area">
		<div class="wrap">
			<h2 class="section-title">対応エリア</h2>
			<img class="area-image" src="/images/top/area.png" alt="大分県内どこでも出張" width="800" height="500" loading="lazy" />
			<p>{site.areas}</p>
		</div>
	</section>
</Base>

<style>
	.fv {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 100svh;
		padding: 48px 16px 120px;
		background: var(--fv-image) center / cover no-repeat;
		text-align: center;
	}
	.fv::before { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(251 247 241 / 0.25), rgb(251 247 241 / 0.55)); }
	.fv-inner {
		position: relative;
		max-width: 560px;
		padding: 40px 32px;
		background: rgb(251 247 241 / 0.92);
		border-radius: 48% 52% 46% 54% / 12% 14% 12% 14%;
		box-shadow: 0 20px 60px rgb(61 53 48 / 0.15);
	}
	.fv-logo { width: 280px; }
	.fv-lead { margin: 16px 0 0; color: var(--accent); font-weight: bold; }
	.fv-title { margin: 4px 0 24px; font-size: 2.2rem; line-height: 1.4; }
	.fv-scroll { position: absolute; left: 50%; bottom: 72px; transform: translateX(-50%); color: var(--text); font-size: 0.75rem; letter-spacing: 0.2em; text-decoration: none; }
	.fv-scroll::after { content: ""; display: block; width: 1px; height: 32px; margin: 4px auto 0; background: var(--text); }
	.fv-wave { position: absolute; left: 0; right: 0; bottom: -1px; width: 100%; height: 64px; fill: var(--bg); }

	.intro { display: flex; align-items: center; gap: 32px; max-width: 900px; }
	.intro + .intro { margin-top: 40px; }
	.intro.is-reverse { flex-direction: row-reverse; }
	.intro-photo { flex: none; width: 200px; }
	.intro-photo.is-round { border-radius: 50%; }
	/* 白地のイラストを生成りの地色になじませる */
	.intro-photo:not(.is-round), .area-image { mix-blend-mode: multiply; }
	.intro-title { margin: 0 0 8px; font-size: 1.4rem; color: var(--accent); }
	.intro p { margin: 0 0 8px; }

	.section { padding: 48px 0 0; }
	.section-title { text-align: center; font-size: 1.6rem; margin: 0 0 24px; }
	.section-title::after { content: ""; display: block; width: 48px; height: 3px; margin: 8px auto 0; background: var(--accent); }

	.cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; list-style: none; margin: 0; padding: 0; }
	.card { display: flex; flex-direction: column; background: #fff; border-radius: var(--radius); padding: 16px; box-shadow: 0 8px 24px rgb(61 53 48 / 0.06); }
	.card-image { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 14px; }
	.card h3 { margin: 16px 0 8px; font-size: 1.15rem; }
	.card p { flex: 1; margin: 0 0 16px; font-size: 0.92rem; }

	.btn { display: inline-block; align-self: center; padding: 10px 28px; border-radius: 80px; background: var(--accent); color: #fff; font-weight: bold; text-decoration: none; }
	.btn:hover { background: var(--accent-dark); }
	.btn-large { font-size: 1.6rem; padding: 12px 40px; }

	.cta { text-align: center; }
	.cta .wrap { background: var(--accent-soft); border-radius: 40px; padding: 40px 16px; }
	.cta-lead { margin: 0 0 16px; font-weight: bold; font-size: 1.15rem; }

	.news { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
	.news li { display: flex; gap: 16px; padding: 12px 4px; border-bottom: 1px solid var(--line); }
	.news time { flex: none; color: var(--muted); font-size: 0.9rem; }
	.news a { color: var(--text); text-decoration: none; }
	.news a:hover { color: var(--accent-dark); text-decoration: underline; }
	.more { text-align: right; }

	.area p { max-width: 860px; margin: 0 auto; }
	.area-image { display: block; margin: 0 auto 16px; max-width: 480px; width: 100%; }

	@media (max-width: 768px) {
		.fv-inner { padding: 32px 20px; }
		.fv-logo { width: 200px; }
		.fv-title { font-size: 1.6rem; }
		.cards { grid-template-columns: 1fr; }
		.intro, .intro.is-reverse { flex-direction: column; text-align: left; }
		.intro-photo { width: 160px; }
		.news li { flex-direction: column; gap: 0; }
		.btn-large { font-size: 1.3rem; padding: 12px 28px; }
	}
</style>
