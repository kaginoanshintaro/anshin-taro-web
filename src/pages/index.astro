		max-height: 100svh;
		overflow: hidden;
	}
	.fv picture, .fv img { display: block; width: 100%; height: 100%; }
	.fv img { object-fit: cover; }

	/* ファーストビューの下: 大きなロゴ、2行、代表の写真、あいさつ文（本番と同じ並び） */
	.greeting { padding: 64px 0 40px; text-align: center; }
	.greeting-logo { width: 830px; }
	.greeting-lead { margin: 90px 0 0; font-size: 1.6rem; line-height: 1.5; }
	.greeting-sub { margin: 4px 0 0; }
	.greeting-photo { margin: 24px auto 0; }
	.greeting-photo img { width: 210px; border-radius: 50%; }
	.greeting-photo figcaption { font-size: 0.8rem; color: var(--muted); }
	.greeting-text { margin-top: 96px; }
	.greeting-text p { margin: 0 0 1.9em; }

	/* 本番と同じ画像と文の横並び。2人の画像は本番の 20% より広めにしている。画像の白い背景は透明にしてあるので地色のクリーム色が見える */
	.characters { max-width: 1200px; margin: 0 auto; padding: 40px 16px 0; }
	.character { display: grid; grid-template-columns: 300px auto; align-items: center; gap: 24px; }
	.character img { width: 100%; height: auto; }
	.character h2 { margin: 0 0 1.2em; font-size: 1.25rem; color: var(--heading); }
	.character-name { font-size: 1.5rem; }
	.character p { margin: 0 0 1.4em; }

	@media (max-width: 768px) {
		.greeting-logo { width: 280px; }
		.greeting-lead { margin-top: 48px; font-size: 1.3rem; }
		.greeting-text br { display: none; }
		.character { grid-template-columns: 1fr; text-align: center; }
		.character img { width: 260px; margin: 0 auto; }
		.character p { text-align: left; }
		.character br { display: none; }
	}

	/* ここから下は固定背景エリア。部品の見た目は src/styles/top.css */
	:global(html) { scroll-snap-type: y proximity; }
	.fixed-area { position: relative; height: 100vh; height: 100svh; padding-top: var(--header-h); clip-path: inset(0); scroll-snap-align: start; }
	/* 写真は画面に固定（新しい背景は佐藤さんが用意予定。今は作業風景の写真） */
	.fa-bg { position: fixed; inset: 0; background: url("/images/top/fixed-bg.webp") center / cover; z-index: 0; }
	.fixed-area > .fa-pc, .fixed-area > .fa-sp { position: relative; z-index: 1; height: 100%; }
	.fa-pc .stage { height: 100%; padding-top: 16px; padding-bottom: 16px; }
	/* スマホは2ページ切り替えの部品を、画面ではなくこのエリアの中に置く */
	.fa-sp { max-width: 520px; margin: 0 auto; }
	.fa-sp .viewport, .fa-sp .dock { position: absolute; }
	.fa-sp .viewport { top: 0; }
	.fa-sp .dock { z-index: 3; }
	.fa-sp .switch { position: absolute; z-index: 5; }
	.fa-pc { display: none; }
	@media (min-width: 1200px) {
		.fa-pc { display: block; }
		.fa-sp { display: none; }
	}
</style>
