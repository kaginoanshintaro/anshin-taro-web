---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import { site } from "../site";
import "../styles/top.css";

const { entries: latest, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 3,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// ファーストビューの大きな画像（佐藤さん指定: シリンダー.jpg）。
// 表示を速くするため、画面幅に合わせた WebP を img で最初に読み込む（背景CSSだと見つかるのが遅い）
// 2026-10-25 佐藤さんの新しい写真（合鍵の機械で作業する手元）。AVIF を読めるブラウザは AVIF、それ以外は WebP
const fvWidths = [800, 1200, 1800, 2400];
const fvSet = (ext: string) => fvWidths.map((w) => `/images/top/fv-keycut-${w}.${ext} ${w}w`).join(", ");
const fvImage = "/images/top/fv-keycut-1800.webp";

const dateFormat = new Intl.DateTimeFormat("ja-JP", {
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
	timeZone: "Asia/Tokyo",
});
---

<!-- フッターは付けない（佐藤さんの指示 2026-10-25）。固定背景エリアがページの最後 -->
<Base title={site.name} description={site.tagline} hideFooter>
	<!-- ここから2人の紹介までは、今の WordPress のトップと同じ並びと大きさ（佐藤さんの指示で本番に戻した） -->
	<section class="fv" aria-label={site.name}>
		<picture>
			<source type="image/avif" srcset={fvSet("avif")} sizes="100vw" />
			<img src={fvImage} srcset={fvSet("webp")} sizes="100vw" width="1800" height="1013" alt="" fetchpriority="high" decoding="async" />
		</picture>
	</section>

	<section class="greeting">
		<div class="wrap">
			<img class="greeting-logo" src="/images/top/logo.webp" alt={site.name} width="600" height="240" />
			<h1 class="greeting-lead">いつ、いかなる時も 佐藤 が参ります</h1>
			<p class="greeting-sub">一人社長の鍵屋さんです</p>
			<figure class="greeting-photo">
				<img src="/images/top/sato.webp" alt="代表の佐藤" width="320" height="320" loading="lazy" />
				<figcaption>／私が佐藤です＼</figcaption>
			</figure>
			<div class="greeting-text">
				<p>弊社では従業員を置かず代表の私、佐藤が直接電話応対から作業までを一手に担います。<br />依頼が集中する場合は少々お待ちいただくこともございますが、その分仲介手数料などの余計なコストが発生せず<br />お客様一人ひとりに向けた丁寧で柔軟なサービスを提供できることが弊社の強みです。</p>
				<p>お客様が “安心して依頼できる” 信頼のおける会社を目指し、日々努力を重ねております。<br />お客様の立場に立ったサービスを心掛け、皆様にとって最良のパートナーであり続けることをお約束いたします。</p>
			</div>
		</div>
	</section>

	<section class="characters">
		<div class="character">
			<img src="/images/top/anshin-taro-and-baby.webp" alt="安心太郎ちゃんとカギベイビー" width="600" height="600" loading="lazy" />
			<div>
				<h2><span class="character-name">安心太郎</span>ちゃん＆<span class="character-name">カギベイビー</span></h2>
				<p>カギの安心太郎株式会社のマスコットキャラクター、AIエージェントの安心太郎ちゃんとカギベイビーです。<br />暮らしの安心と安全を守るため、佐藤と共に活躍しています。よろしくね！<br />ホームページをブックマークすると、安心太郎ちゃんの顔がアイコンになるよ。試してみてね！</p>
			</div>
		</div>
	</section>

	<!--
		2人の紹介の下の「固定背景エリア」（2026-10-24 の見本 top-pc.html / top-sp.html と同じ）。
		1画面ぴったりで、後ろの写真は画面に固定。窓はすりガラス、太郎ちゃんのチャットだけ透明。
		広い画面は .fa-pc、それ以外はスマホの2ページ切り替え .fa-sp を出す。
		「見本」の札が付いている所（ニュース・チャット・予定）は、まだ見た目だけ。
	-->
	<section class="fixed-area fa" id="top-area" aria-label="安心太郎ちゃんと最新情報">
		<div class="fa-bg"></div>
		<div class="fa-pc">
			<div class="stage">
				<div class="col">
					<section class="panel">
						<h2 class="panel-title">最新の記事</h2>
						<ul class="list">
							{latest.map((post) => (
								<li>{post.data.publishedAt && <time class="date" datetime={post.data.publishedAt.toISOString()}>{dateFormat.format(post.data.publishedAt)}</time>}<a href={`/${post.id}/`}>{post.data.title}</a></li>
							))}
						</ul>
						<p class="more"><a href="/news/">記事をもっと見る →</a></p>
					</section>
					<section class="panel news-panel">
						<div class="news-head">
							<img loading="lazy" decoding="async" src="/images/top/baby-face.webp" alt="" />
							<div><h2 class="panel-title">ベビちゃんの鍵業界ニュース</h2><span class="tag-sample">見本</span></div>
						</div>
						<ul class="list">
							<li><span class="date">10/20</span>今週のニュースの見出しが入ります<p class="comment"><b>佐藤のひとこと</b>ここに佐藤さんの一言コメントが入ります。</p></li>
							<li><span class="date">10/13</span>先週のニュースの見出しが入ります<p class="comment"><b>佐藤のひとこと</b>コメントが無い週は出しません。</p></li>
							<li><span class="date">10/06</span>先々週のニュースの見出しが入ります</li>
						</ul>
						<p class="more">ニュース一覧 →</p>
					</section>
					<section class="panel cal">
						<div class="cal-head"><h2 class="panel-title">佐藤の予定 <span class="tag-sample">見本</span></h2></div>
						<div class="week">
							<span></span><span class="day sat">10/24 土</span><span class="day sun">25 日</span><span class="day">26 月</span><span class="day">27 火</span><span class="day">28 水</span><span class="day">29 木</span><span class="day">30 金</span>
							<div class="hours"><span>9時</span><span>11時</span><span>13時</span><span>15時</span><span>17時</span></div>
							<div class="col-day"><span class="busy" style="top:3px;height:25px">予定あり</span></div>
							<div class="col-day"></div>
							<div class="col-day"><span class="busy" style="top:18px;height:33px">予定あり</span><span class="busy" style="top:59px;height:16px"></span></div>
							<div class="col-day"><span class="busy" style="top:33px;height:18px">予定あり</span></div>
							<div class="col-day"><span class="busy" style="top:3px;height:41px">予定あり</span><span class="busy" style="top:54px;height:29px">予定あり</span></div>
							<div class="col-day"></div>
							<div class="col-day"><span class="busy" style="top:46px;height:25px">予定あり</span></div>
						</div>
					</section>
				</div>

				<div class="center">
					<section class="panel chat">
						<div class="chat-head-label">
							<p class="chat-name">安心太郎ちゃん <span class="tag-sample">見本</span></p>
							<p class="chat-sub">AIエージェント／サイトの案内と質問の受付</p>
						</div>
						<div class="chat-body">
							<img loading="lazy" decoding="async" class="taro" src="/images/top/taro-full.webp" alt="安心太郎ちゃん" />
							<div class="msgs">
								<div class="msg bot"><div class="bubble">こんにちは、安心太郎だよ！<br />鍵のことやこのサイトのこと、なんでも聞いてね。</div></div>
								<div class="msg user"><div class="bubble">家の鍵をなくしちゃいました。来てもらえますか？</div></div>
								<div class="msg bot"><div class="bubble">大分県内なら佐藤が出張するよ。急ぎのときは電話がいちばん早いよ！<br />左のカレンダーで佐藤の空き具合も見られるよ。</div></div>
							</div>
						</div>
						<div class="chips">
							<span class="chip">料金を知りたい</span>
							<span class="chip">対応エリアは？</span>
							<span class="chip">車の鍵も作れる？</span>
							<span class="chip">会社の場所</span>
						</div>
						<div class="input"><span>安心太郎ちゃんに質問する…</span><span class="send" aria-hidden="true"><svg class="padlock" viewBox="0 0 24 24"><path class="shackle" d="M8 11V8a4 4 0 0 1 8 0v3" /><rect x="5.5" y="11" width="13" height="9" rx="2" /><circle class="keyhole" cx="12" cy="15.5" r="1.4" /></svg></span></div>
						<p class="note chat-note" style="margin:0">電話番号やメールアドレスは入力しないでね（送る前にお知らせします）</p>
					</section>

				</div>

				<div class="col">
					<a class="btn-tel" href={site.tel.href}><small>電話で見積もり・佐藤が電話に出ます</small>{site.tel.label}</a>
					<a class="panel banner" href="#"><img loading="lazy" decoding="async" src="/images/top/line-v2.webp" alt="LINE 公式アカウント 友だち追加" width="1080" height="346" /></a>
					<div class="small-row">
						<a class="panel banner" href="#" style="background:#f5ff93"><img loading="lazy" decoding="async" src="/images/top/takagaku.webp" alt="高額請求にご注意" /></a>
						<div class="panel"><img loading="lazy" decoding="async" src="/images/top/sa2.webp" alt="SECURITY ACTION 二つ星" /></div>
						<a class="panel insta" href="#" aria-label="佐藤の Instagram"><svg viewBox="0 0 64 64" aria-hidden="true"><defs><linearGradient id="ig" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#f9a23b"/><stop offset=".45" stop-color="#e1306c"/><stop offset="1" stop-color="#7a3cc4"/></linearGradient></defs><rect x="2" y="2" width="60" height="60" rx="16" fill="url(#ig)"/><rect x="14" y="14" width="36" height="36" rx="11" fill="none" stroke="#fff" stroke-width="4"/><circle cx="32" cy="32" r="8.5" fill="none" stroke="#fff" stroke-width="4"/><circle cx="43" cy="21" r="2.6" fill="#fff"/></svg></a>
					</div>
					<a class="bank" href="/tipshints/">
						<svg class="bulb" viewBox="0 0 48 48" aria-hidden="true"><g stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M24 3v4M8.5 9.5l2.8 2.8M39.5 9.5l-2.8 2.8M3 24h4M41 24h4"/></g><path d="M24 11a12 12 0 0 0-7.2 21.6c1.2 1 2.2 2.6 2.2 4.4h10c0-1.8 1-3.4 2.2-4.4A12 12 0 0 0 24 11z" fill="#ffd36b" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round"/><path d="M19.5 41h9M21 45h6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
						<span><b>お役立ち情報</b><small>鍵の技術・防犯・コラムの一覧</small></span>
						<span class="arrow">→</span>
					</a>
					<section class="panel company" aria-label="会社情報">
						<p class="co-head"><span>{site.name}</span><span>〒{site.postalCode}</span></p>
						<p class="co-addr">{site.addressLine}</p>
						<p class="co-contact"><a href={site.tel.href}>{site.tel.label}</a><a href={`mailto:${site.email}`}>{site.email}</a></p>
					</section>
				</div>
			</div>
		</div>
		<div class="fa-sp">
			<div class="viewport">
				<div class="track">
					<div class="page page1">
				<section class="panel chat">
					<div>
						<p class="chat-name">安心太郎ちゃん <span class="tag-sample">見本</span></p>
					</div>
					<div class="chat-body">
						<img decoding="async" class="taro" src="/images/top/taro-full.webp" alt="安心太郎ちゃん" />
						<div class="msgs">
							<div class="msg bot"><div class="bubble">こんにちは、安心太郎だよ！鍵のこと、なんでも聞いてね。</div></div>
							<div class="msg user"><div class="bubble">家の鍵をなくしちゃいました</div></div>
							<div class="msg bot"><div class="bubble">大分県内なら佐藤が出張するよ。急ぎなら下の電話からどうぞ！</div></div>
						</div>
					</div>
					<div class="chips">
						<span class="chip">料金を知りたい</span>
						<span class="chip">対応エリアは？</span>
						<span class="chip">車の鍵も作れる？</span>
					</div>
					<div class="input"><span>質問する…</span><span class="send" aria-hidden="true"><svg class="padlock" viewBox="0 0 24 24"><path class="shackle" d="M8 11V8a4 4 0 0 1 8 0v3" /><rect x="5.5" y="11" width="13" height="9" rx="2" /><circle class="keyhole" cx="12" cy="15.5" r="1.4" /></svg></span></div>
				</section>
				<a class="panel mini-cal" href="#" aria-label="佐藤の予定（7日分）">
					<p class="cal-cap"><b>佐藤の予定</b><span><i class="key"></i>予定あり　9時〜18時</span></p>
					<div class="days"><div class="sat"><span>24<small>土</small></span><i><b style="top:0%;height:25%"></b></i></div><div class="sun"><span>25<small>日</small></span><i></i></div><div class=""><span>26<small>月</small></span><i><b style="top:20%;height:35%"></b><b style="top:70%;height:15%"></b></i></div><div class=""><span>27<small>火</small></span><i><b style="top:35%;height:20%"></b></i></div><div class=""><span>28<small>水</small></span><i><b style="top:0%;height:45%"></b><b style="top:60%;height:35%"></b></i></div><div class=""><span>29<small>木</small></span><i></i></div><div class=""><span>30<small>金</small></span><i><b style="top:50%;height:25%"></b></i></div></div>
				</a>
					</div>
					<div class="page page2">
						<section class="panel links">
					<div class="row-title"><h2 class="panel-title">最新の記事</h2><a href="/news/">もっと見る →</a></div>
					<ul>
						{latest.map((post) => <li><a href={`/${post.id}/`}>{post.data.title}</a></li>)}
					</ul>
					<div class="row-title" style="margin-top:10px"><h2 class="panel-title">ベビちゃんの鍵業界ニュース <span class="tag-sample">見本</span></h2></div>
					<ul>
						<li><a href="#">今週のニュースの見出しが入ります</a><p class="comment"><b>佐藤のひとこと</b>ここに佐藤さんの一言コメントが入ります。</p></li>
						<li><a href="#">先週のニュースの見出しが入ります</a><p class="comment"><b>佐藤のひとこと</b>コメントが無い週は出しません。</p></li>
					</ul>
				</section>
						<!-- ボタンは大きいアイコンと短い言葉だけ（佐藤さんの指示 2026-10-24: 小さい文字は読めないので極力シンプルに） -->
						<section class="svc">
							<div class="tiles3">
								<a class="tile" href="/lock-opening/"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 7.6-1.7"/><circle cx="12" cy="16" r="1.4"/></svg><b>開錠</b></a>
								<a class="tile" href="/repair/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 4a4.5 4.5 0 0 0-4.2 6.1L4 16.4V20h3.6l6.3-6.3A4.5 4.5 0 0 0 20 9.5l-2.8 2.8-3-.5-.5-3L16.5 6A4.5 4.5 0 0 0 14.5 4z"/></svg><b>修理・交換</b></a>
								<a class="tile" href="/duplicate/"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="8" r="4.5"/><path d="M11.2 11.2L20 20M16 16l2-2M18.5 18.5l2-2"/></svg><b>鍵作成</b></a>

							</div>
						</section>
						<div class="tiles2">
							<a class="tile row" href="/price/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4l5 8 5-8M12 12v8M8 13h8M8 17h8"/></svg><b>料金表</b></a>
							<button class="tile row prof-btn" type="button"><img decoding="async" src="/images/top/sato.webp" alt="" /><b>佐藤</b></button>
						</div>
						<div class="icons4">
							<a class="ic bulb-ic" href="/tipshints/" aria-label="お役立ち情報"><svg class="bulb" viewBox="0 0 48 48" aria-hidden="true"><g stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M24 3v4M8.5 9.5l2.8 2.8M39.5 9.5l-2.8 2.8M3 24h4M41 24h4"/></g><path d="M24 11a12 12 0 0 0-7.2 21.6c1.2 1 2.2 2.6 2.2 4.4h10c0-1.8 1-3.4 2.2-4.4A12 12 0 0 0 24 11z" fill="#ffd36b" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round"/><path d="M19.5 41h9M21 45h6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg></a>
							<a class="insta" href="#" aria-label="佐藤の Instagram"><svg viewBox="0 0 64 64" aria-hidden="true"><defs><linearGradient id="ig-sp" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#f9a23b"/><stop offset=".45" stop-color="#e1306c"/><stop offset="1" stop-color="#7a3cc4"/></linearGradient></defs><rect x="2" y="2" width="60" height="60" rx="16" fill="url(#ig-sp)"/><rect x="14" y="14" width="36" height="36" rx="11" fill="none" stroke="#fff" stroke-width="4"/><circle cx="32" cy="32" r="8.5" fill="none" stroke="#fff" stroke-width="4"/><circle cx="43" cy="21" r="2.6" fill="#fff"/></svg></a>
							<span class="ic sa"><img decoding="async" src="/images/top/sa2.webp" alt="SECURITY ACTION 二つ星" /></span>
							<a class="ic hand" href="#" aria-label="パートナー企業募集"><img decoding="async" src="/images/top/partner-key.webp" alt="" /><b>募集</b></a>
						</div>
						<div class="tiles2">
							<a class="tile row" href="/profile/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6-5.5-6-11a6 6 0 0 1 12 0c0 5.5-6 11-6 11z"/><circle cx="12" cy="10" r="2.2"/></svg><b>アクセス</b></a>
							<a class="tile row coupon2" href="#" aria-label="LINE友だち追加で10%OFFクーポン"><span class="line-mark">LINE</span><b>10%OFF</b></a>
						</div>
						<a class="warn2" href="#"><img decoding="async" src="/images/top/takagaku.webp" alt="高額請求にご注意" /></a>
					</div>
				</div>
				<div class="rack"></div>
			</div>

			<nav class="dock">
				<a class="tel-icon" href={site.tel.href} aria-label={`電話する ${site.tel.label}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg></a>
				<span class="gap"></span>
				<a class="line-min" href="#" aria-label="LINEで相談・友だち追加"><span class="line-mark big">LINE</span></a>
			</nav>
			<button class="switch" type="button" aria-label="2ページ目へ">
				<img decoding="async" class="gear" src="/images/top/gear.svg" alt="" />
				<span class="cap"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></span>
				<span class="num">1 / 2</span>
			</button>
			<div class="prof" role="dialog" aria-label="佐藤のプロフィール">
				<div class="prof-card">
					<button class="close" type="button" aria-label="閉じる">×</button>
					<img decoding="async" src="/images/top/sato.webp" alt="代表の佐藤" />
					<h2>代表　佐藤 翔平</h2>
					<p class="kana">さとう しょうへい</p>
					<dl><dt>会社</dt><dd>カギの安心太郎株式会社</dd><dt>創業</dt><dd>2024年1月1日</dd><dt>従業員</dt><dd>1人（一人社長の鍵屋さん）</dd></dl>
					<p>弊社では従業員を置かず代表の私、佐藤が直接電話応対から作業までを一手に担います。</p>
					<a class="to-profile" href="/profile/">会社概要・アクセスを見る →</a>
				</div>
			</div>
		</div>
	</section>
</Base>

<script is:inline>
	// スマホ: 歯車ボタンで1ページ目と2ページ目を切り替える
	(() => {
		const sp = document.querySelector(".fa-sp");
		const btn = sp.querySelector(".switch"), track = sp.querySelector(".track");
		btn.addEventListener("click", () => {
			const two = document.body.classList.toggle("on2");
			btn.setAttribute("aria-label", two ? "1ページ目へ" : "2ページ目へ");
			btn.querySelector(".num").textContent = two ? "2 / 2" : "1 / 2";
		});
		// 止まったときに少し揺らして「カチッ」と噛み合った感じにする
		track.addEventListener("transitionend", () => { track.parentElement.classList.remove("clunk"); void track.offsetWidth; track.parentElement.classList.add("clunk"); });
		// 佐藤のプロフィールの小窓
		sp.querySelector(".prof-btn").addEventListener("click", () => document.body.classList.add("prof-open"));
		sp.querySelector(".prof .close").addEventListener("click", () => document.body.classList.remove("prof-open"));
	})();

	// パソコン: 見本は 1440×900 の画面（ヘッダーの下 808px）で作ったので、ブラウザの表示の高さがそれより低いときは
	// 全体を縮めて1画面に収める（佐藤さんの確認 2026-10-25: ヘッダーの分だけ収まっていなかった）
	(() => {
		const pc = document.querySelector(".fa-pc"), stage = pc.querySelector(".stage");
		const DESIGN_H = 808;
		const fit = () => {
			if (getComputedStyle(pc).display === "none") return;
			const avail = pc.clientHeight;
			const s = Math.min(1, avail / DESIGN_H);
			stage.style.zoom = String(s);
			stage.style.height = `${avail / s}px`;
		};
		fit();
		addEventListener("resize", fit);
	})();

	// 太郎ちゃんのパトロール: 9秒歩いて、立ち止まったら挨拶を1つチャットに出し、5秒後にまた歩き出す
	document.querySelectorAll(".fa .chat").forEach((chat) => {
		const msgs = chat.querySelector(".msgs");
		const hellos = ["こんにちは！今日も街をパトロール中だよ。", "戸締まりはしっかりね！", "鍵のことで困ったら話しかけてね。", "鍵がまわりにくい時は無理しないで相談してね。"];
		let i = 0;
		const walk = () => { chat.classList.add("walking"); setTimeout(stop, 9000); };
		const stop = () => {
			chat.classList.remove("walking");
			const m = document.createElement("div");
			m.className = "msg bot hello";
			m.innerHTML = '<div class="bubble"></div>';
			m.firstChild.textContent = hellos[i++ % hellos.length];
			msgs.append(m);
			// 見えなくなった古い吹き出しは消す
			while (msgs.children.length > 6) msgs.firstElementChild.remove();
			setTimeout(walk, 5000);
		};
		walk();
	});

	// 佐藤の予定: 固定背景エリアが画面に入ったら、予定のブロックを鍵のピンのように下から上げる（一度だけ）
	(() => {
		const area = document.querySelector("#top-area");
		if (!("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
		area.classList.add("pins-ready");
		const io = new IntersectionObserver((es) => {
			if (!es.some((e) => e.isIntersecting)) return;
			requestAnimationFrame(() => area.classList.add("pins-set"));
			io.disconnect();
		}, { threshold: 0.6 });
		io.observe(area);
	})();
</script>

<style>
