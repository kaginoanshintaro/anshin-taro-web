---
// 利用規約（/terms/。URL は今の WordPress と同じ）。
// 文は src/data/terms.ts（今のページから写したもの）。
// 形はプライバシーポリシーと同じ（細い帯＋左の追従目次＋右の白カード）。CSS も privacy.css を使う。
import Base from "../layouts/Base.astro";
import { termsEnacted, termsIntro, termsSections } from "../data/terms";
import "../styles/privacy.css";

// 文中の [文字](/パス/)・URL・電話番号をリンクにする（スマホで押せるように）
const linkPattern = /(\[[^\]]+\]\([^)]+\)|https?:\/\/[^\s　]+|0\d{1,3}-\d{2,4}-\d{4})/;
const parts = (text: string) =>
	text
		.split(linkPattern)
		.filter(Boolean)
		.map((t) => {
			const md = t.match(/^\[([^\]]+)\]\(([^)]+)\)$/);
			if (md) return { text: md[1], href: md[2] };
			if (/^https?:/.test(t)) return { text: t, href: t };
			if (/^0\d[\d-]+$/.test(t)) return { text: t, href: `tel:${t.replace(/-/g, "")}` };
			return { text: t, href: null };
		});
---

<Base title="利用規約">
	<div class="privacy-page terms-page">
		<header class="pv-head">
			<div class="wrap">
				<h1>利用規約</h1>
				<nav class="pv-crumb" aria-label="現在地"><a href="/">ホーム</a><span aria-hidden="true">›</span>利用規約</nav>
			</div>
		</header>

		<div class="wrap pv-layout">
			<aside class="pv-side">
				<nav aria-label="項目">
					<details class="pv-toc" open>
						<summary class="pv-toc-title">目次</summary>
						<ol>
							{termsSections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
						</ol>
					</details>
				</nav>
			</aside>

			<article class="pv-card">
				<div class="tm-intro">
					{termsIntro.map((p) => <p>{p}</p>)}
				</div>
				{termsSections.map((s, i) => (
					<section id={s.id}>
						<h2><span class="tm-num">{i + 1}.</span>{s.title}</h2>
						{s.body.map((b) =>
							typeof b === "string" ? (
								<p>{parts(b).map((t) => (t.href ? <a href={t.href}>{t.text}</a> : t.text))}</p>
							) : (
								<ul>{b.list.map((li) => <li>{parts(li).map((t) => (t.href ? <a href={t.href}>{t.text}</a> : t.text))}</li>)}</ul>
							),
						)}
					</section>
				))}
				<p class="tm-enacted">{termsEnacted}</p>
			</article>
		</div>

		<div class="pv-cta">
			<a class="pv-cta-home" href="/">ホームに戻る</a>
		</div>
	</div>
</Base>

<script>
	// スマホでは目次を閉じた状態から始め、項目を押したら閉じる。パソコンは開いたまま（プライバシーポリシーと同じ）
	const toc = document.querySelector<HTMLDetailsElement>(".pv-toc");
	const phone = window.matchMedia("(max-width: 767px)");
	if (toc) {
		toc.open = !phone.matches;
		phone.addEventListener("change", () => (toc.open = !phone.matches));
		toc.querySelector("summary")?.addEventListener("click", (e) => {
			if (!phone.matches) e.preventDefault();
		});
		toc.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => {
			if (phone.matches) toc.open = false;
		}));
	}
</script>
