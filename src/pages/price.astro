---
// サービス料金（/price/。URL は今の WordPress と同じ）。
// 文と金額は src/data/price.ts（今のページから写したもの）。
// パソコン版: 左に料金メニュー（スクロールしても付いてくる）、右に種類ごとのカード。
import Base from "../layouts/Base.astro";
import { site } from "../site";
import { priceSections } from "../data/price";
import "../styles/price.css";

// 一番下の「電話で問い合わせる」は今のページと同じ番号（佐藤さんの指示 2026-10-25）
const ctaTel = { label: "080-6416-9440", href: "tel:08064169440" };
---

<Base title="サービス料金">
	<div class="price-page">
		<header class="pp-head">
			<div class="wrap">
				<h1>サービス料金</h1>
				<nav class="pp-crumb" aria-label="現在地"><a href="/">ホーム</a><span aria-hidden="true">›</span>サービス料金</nav>
			</div>
		</header>

		<div class="wrap pp-layout">
			<aside class="pp-side">
				<nav class="pp-toc" aria-label="料金の種類">
					<p class="pp-toc-title">料金メニュー</p>
					<ol>
						{priceSections.map((s) => <li><a href={`#${s.id}`}>{s.short}</a></li>)}
						<li class="pp-toc-sub"><a href="#immobilizer-check">イモビライザー搭載車の見分け方</a></li>
					</ol>
				</nav>
				<a class="pp-tel" href={site.tel.href}><small>電話で見積もり</small>{site.tel.label}</a>
			</aside>

			<div class="pp-main">
				<!-- 注意書きの見せ方を3案並べている（佐藤さんが選んだら1つだけ残す） -->
				<p class="pp-variant">注意書き 案A：3つのカード</p>
				<section class="pp-notes-a" aria-label="料金について">
					<div class="cards">
						<div><p class="k">料金</p><p class="v">出張料・税込み</p><p class="s">の金額です</p></div>
						<div><p class="k">深夜早朝（pm20:00〜am8:00）</p><p class="v">＋3,300円</p><p class="s">の料金となります</p></div>
						<div><p class="k">キャンセル料</p><p class="v sm">日中 5,500円<br />夜間早朝 8,800円</p><p class="s">お見積もり以外のサービスについては出発してからのキャンセルはキャンセル料が発生いたします。</p></div>
					</div>
					<p class="ask">料金項目にない場合などご不明点はお気軽にお問い合わせください。</p>
				</section>

				<p class="pp-variant">注意書き 案B：料金表と同じ形</p>
				<section class="pp-card pp-notes-b" aria-label="料金について">
					<p class="lead"><strong>出張料・税込み</strong>の金額です</p>
					<dl class="pp-table">
						<div><dt>深夜早朝（pm20:00〜am8:00）</dt><dd>＋3,300円</dd></div>
						<div><dt>キャンセル料　日中（8:00〜20:00）</dt><dd>5,500円</dd></div>
						<div><dt>キャンセル料　夜間早朝（20:00〜8:00）</dt><dd>8,800円</dd></div>
					</dl>
					<ul>
						<li>お見積もり以外のサービスについては出発してからのキャンセルは<strong>キャンセル料</strong>が発生いたします。</li>
						<li>料金項目にない場合などご不明点はお気軽にお問い合わせください。</li>
					</ul>
				</section>

				<p class="pp-variant">注意書き 案C：細い帯</p>
				<section class="pp-notes-c" aria-label="料金について">
					<div class="chips">
						<span><b>出張料・税込み</b>の金額です</span>
						<span>深夜早朝（20:00〜8:00）<b>＋3,300円</b></span>
						<span>キャンセル料 日中<b>5,500円</b>／夜間早朝<b>8,800円</b></span>
					</div>
					<p>※お見積もり以外のサービスについては出発してからのキャンセルはキャンセル料が発生いたします。料金項目にない場合などご不明点はお気軽にお問い合わせください。</p>
				</section>

				{priceSections.map((s) => (
					<section class="pp-card" id={s.id}>
						<h2>{s.title}</h2>
						<div class="pp-intro">
							<img src={s.image.src} width={s.image.width} height={s.image.height} alt="" loading="lazy" decoding="async" />
							<div class="pp-body">{s.body.map((p) => <p>{p}</p>)}</div>
						</div>
						<div class:list={["pp-table-wrap", { "has-photo": s.photo }]}>
							<div>
								{s.tableTitle && <p class="pp-table-title">{s.tableTitle}</p>}
								<dl class="pp-table">
									{s.rows.map((r) => (
										<div>
											<dt>{r.name}</dt>
											<dd>{r.price}{r.note && <small>{r.note}</small>}</dd>
										</div>
									))}
								</dl>
							</div>
							{s.photo && (
								<figure class="pp-photo">
									<img src={s.photo.src} width="560" height="560" alt={s.photo.alt} loading="lazy" decoding="async" />
									<figcaption>{s.photo.alt}</figcaption>
								</figure>
							)}
						</div>
					</section>
				))}

				<!-- イモビライザー搭載車の見分け方（今のページの会話をそのまま） -->
				<section class="pp-card pp-talk" id="immobilizer-check">
					<div class="talk taro"><img src="/images/price/taro-teacher-face.webp" width="200" height="200" alt="安心太郎ちゃん" /><p><strong>イモビライザー搭載車の見分け方について解説するよ</strong></p></div>

					<h3>１、メーターパネルの警告灯で確認</h3>
					<div class="talk baby"><img src="/images/top/baby-face.webp" width="160" height="160" alt="カギベイビー" /><p><strong>これらの表示があればイモビライザーシステム搭載だね</strong></p></div>
					<div class="pp-lamps">
						<img src="/images/price/warn1.webp" width="218" height="100" alt="IMMOBILIZER の警告灯" loading="lazy" />
						<img src="/images/price/warn2.webp" width="132" height="116" alt="錠前の形の警告灯" loading="lazy" />
						<img src="/images/price/warn3.webp" width="226" height="138" alt="車と鍵の形の警告灯" loading="lazy" />
						<img src="/images/price/warn4.webp" width="214" height="152" alt="SECURITY の警告灯" loading="lazy" />
					</div>

					<h3>2. 鍵自体を確認する</h3>
					<ul class="pp-check">
						<li>グリップ部分が<strong>厚め・プラスチック製</strong><span>→</span>チップ内蔵の可能性あり</li>
						<li>金属のみのシンプルな鍵<span>→</span>イモビなし</li>
						<li>スマートキー<span>→</span>ほぼイモビあり</li>
					</ul>
					<div class="talk baby"><img src="/images/top/baby-face.webp" width="160" height="160" alt="カギベイビー" /><p>見た目だけでの判断はちょっと難しいかもね〜</p></div>

					<h3>3. 年式・車種で判断する</h3>
					<table class="pp-year">
						<tr><th>国産車</th><td>2000年代以降はほぼ標準搭載</td></tr>
						<tr><th>輸入車</th><td>1990年代後半から搭載モデルあり</td></tr>
						<tr><th>軽トラ・旧車</th><td>搭載されていないケースが多い</td></tr>
					</table>
					<div class="talk baby"><img src="/images/top/baby-face.webp" width="160" height="160" alt="カギベイビー" /><p>最近の車はほぼイモビライザー搭載なんだね！</p></div>

					<h3>4. 車検証・取扱説明書で確認</h3>
					<ul class="pp-check">
						<li>車検証または取説に「イモビライザー」「盗難防止装置」の記載があれば搭載あり　※表記がない場合もあり</li>
					</ul>
					<div class="talk baby"><img src="/images/top/baby-face.webp" width="160" height="160" alt="カギベイビー" /><p>字を読むのがめんどくさい時ってあるよね〜！</p></div>
					<div class="talk taro"><img src="/images/price/taro-teacher-face.webp" width="200" height="200" alt="安心太郎ちゃん" /><p>少し年式の古い車か商用車、トラックなどはイモビライザー搭載車は少ない印象だね！</p></div>
				</section>

				<div class="pp-cta">
					<a class="pp-cta-tel" href={ctaTel.href}>電話で問い合わせる<span>{ctaTel.label}</span></a>
					<a class="pp-cta-home" href="/">ホームに戻る</a>
				</div>
			</div>
		</div>
	</div>
</Base>
