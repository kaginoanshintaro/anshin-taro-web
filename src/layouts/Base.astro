---
import { getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { site, globalNav, footerNav } from "../site";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content } =
	Astro.props;
const settingsResult = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) Astro.cache.set(settingsResult.cacheHint);

const { siteLogo } = resolveStarterSiteIdentity(settingsResult.data);
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;
const pageDescription = description ?? site.tagline;
const currentPath = Astro.url.pathname;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: site.name,
});
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<header class="site-header">
			<div class="wrap header-inner">
				<a class="brand" href="/">
					<img
						src={siteLogo?.url ?? "/images/top/logo.png"}
						alt={siteLogo?.alt || site.name}
						width="600"
						height="240"
					/>
					<span class="brand-tagline">{site.tagline}</span>
				</a>
				<a class="header-tel" href={site.tel.href}>
					<span class="header-tel-note">お電話でお見積もりOK</span>
					<span class="header-tel-number">{site.tel.label}</span>
				</a>
			</div>
			<nav class="global-nav" aria-label="メインメニュー">
				<ul class="wrap">
					{
						globalNav.map((item) => (
							<li>
								<a href={item.href} aria-current={item.href === currentPath ? "page" : undefined}>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<p class="footer-name">{site.name}</p>
				<p>{site.address}</p>
				<p>TEL <a href={site.tel.href}>{site.tel.label}</a></p>
				<ul class="footer-nav">
					{footerNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
				</ul>
				<p class="copyright">© {site.name}</p>
			</div>
		</footer>

		<div class="sp-fixed-bar">
			<a href="/contact/">お問い合わせ</a>
			<a href={site.tel.href} class="is-tel">{site.tel.label}</a>
		</div>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>

<style is:global>
	:root {
		/* 今のサイトのボタン色（#ff740a）をアクセントに使う */
		--accent: #ff740a;
		--accent-dark: #d95f00;
		--text: #333;
		--muted: #666;
		--line: #e5e5e5;
		--bg-soft: #fff7f0;
		--wrap: 1080px;
	}
	*, *::before, *::after { box-sizing: border-box; }
	body {
		margin: 0;
		color: var(--text);
		font-family: "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Noto Sans JP", Meiryo, sans-serif;
		line-height: 1.8;
		background: #fff;
	}
	img { max-width: 100%; height: auto; }
	a { color: var(--accent-dark); }
	.wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 16px; }

	.site-header { border-top: 4px solid var(--accent); background: #fff; }
	.header-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 12px; padding-bottom: 12px; }
	.brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--text); line-height: 1.3; }
	.brand img { height: 64px; width: auto; }
	.brand-tagline { font-size: 0.85rem; color: var(--muted); }
	.header-tel { display: flex; flex-direction: column; align-items: flex-end; text-decoration: none; color: var(--accent-dark); line-height: 1.3; }
	.header-tel-note { font-size: 0.8rem; color: var(--muted); }
	.header-tel-number { font-size: 1.6rem; font-weight: bold; }

	.global-nav { background: var(--accent); }
	.global-nav ul { display: flex; flex-wrap: wrap; list-style: none; margin: 0 auto; padding-top: 0; padding-bottom: 0; }
	.global-nav a { display: block; padding: 12px 16px; color: #fff; text-decoration: none; font-weight: bold; font-size: 0.95rem; }
	.global-nav a:hover, .global-nav a[aria-current="page"] { background: var(--accent-dark); }

	main { min-height: 50vh; }

	.site-footer { margin-top: 64px; padding: 32px 0 96px; background: #333; color: #ddd; font-size: 0.9rem; }
	.site-footer a { color: #fff; }
	.footer-name { font-weight: bold; font-size: 1.1rem; color: #fff; }
	.footer-nav { display: flex; flex-wrap: wrap; gap: 8px 24px; list-style: none; padding: 0; }
	.copyright { margin-top: 24px; color: #aaa; font-size: 0.8rem; }

	.sp-fixed-bar { display: none; }

	@media (max-width: 768px) {
		.brand img { height: 48px; }
		.brand-tagline { display: none; }
		.header-tel { display: none; }
		.global-nav ul { flex-wrap: nowrap; overflow-x: auto; padding: 0; }
		.global-nav a { white-space: nowrap; padding: 10px 12px; font-size: 0.85rem; }
		.sp-fixed-bar { display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; }
		.sp-fixed-bar a { flex: 1; padding: 14px 8px; text-align: center; font-weight: bold; text-decoration: none; color: #fff; background: #555; }
		.sp-fixed-bar a.is-tel { background: var(--accent); }
	}
</style>
