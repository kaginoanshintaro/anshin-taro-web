---
/**
 * 電話ボタン（全ページ共通）。佐藤さんの決定 2026-11-06:
 * - スマホだけ「押すと電話がかかる」ボタンを出す。
 * - スマホ以外（パソコン・タブレット）は、押しても電話がかからないことが多いので
 *   電話番号は大きな文字で見せたまま、押すところはメール（お問い合わせフォーム /contact/）にする。
 * どちらを出すかは Base.astro の .only-phone / .not-phone（CSS のメディアクエリ）で決める。
 *
 * class: そのページのボタンの見た目（pp-tel など）。スマホ用・パソコン用の両方に付ける。
 * lead: スマホ用ボタンの小さい文字（例「電話で見積もり」）
 */
import { site } from "../site";

interface Props {
	class: string;
	lead: string;
	mailLead?: string;
}
const { class: cls, lead, mailLead = "メールで見積もり・お問い合わせ" } = Astro.props;
---
<a class:list={[cls, "only-phone"]} href={site.tel.href}><small>{lead}</small>{site.tel.label}</a>
<div class:list={[cls, "cb-pc", "not-phone"]}>
	<small>お電話の方は</small>
	<span class="cb-num">{site.tel.label}</span>
	<a class="cb-mail" href="/contact/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5zm2 .9v.3l7 4.9 7-4.9v-.3zm14 2.7-6.4 4.5a1 1 0 0 1-1.2 0L5 10.1V17h14z" /></svg>{mailLead}</a>
</div>
